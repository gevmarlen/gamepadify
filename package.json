{
  "name": "gamepadify-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p packages/angular/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:packages": "node scripts/check-packages.mjs",
    "test:bundles": "node scripts/check-bundles.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run test:packages && npm run test:bundles",
    "dev": "vite demo --host 127.0.0.1",
    "demo:build": "tsc -p demo/tsconfig.json --noEmit && vite build demo --base=/gamepadify/",
    "pack": "node scripts/pack.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@angular/common": "~20.3.34",
    "@angular/compiler": "~20.3.34",
    "@angular/compiler-cli": "~20.3.34",
    "@angular/core": "~20.3.34",
    "@playwright/test": "^1.64.1",
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "jquery": "~3.7.1",
    "jsdom": "30.1.3",
    "ng-packagr": "~20.3.2",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "~3.5.44"
  }
}
