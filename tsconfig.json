{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "gamepadify": [
        "./packages/core/src/index.ts"
      ],
      "gamepadify/*": [
        "./packages/core/src/*.ts"
      ]
    }
  },
  "include": [
    "packages/core/src",
    "packages/react/src",
    "packages/vue/src",
    "packages/jquery/src"
  ]
}
