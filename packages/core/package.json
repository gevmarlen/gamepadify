{
  "name": "gamepadify",
  "version": "0.2.1",
  "description": "Gamepad controls for the web: typed bindings, spatial navigation and adaptive button prompts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/types/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/testing.cjs"
      }
    },
    "./styles.css": "./dist/gamepadify.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./core": {
      "import": {
        "types": "./dist/types/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/core.cjs"
      }
    },
    "./navigation": {
      "import": {
        "types": "./dist/types/navigation.d.ts",
        "default": "./dist/navigation.js"
      },
      "require": {
        "types": "./dist/cjs/navigation.d.ts",
        "default": "./dist/navigation.cjs"
      }
    },
    "./hints": {
      "import": {
        "types": "./dist/types/hints.d.ts",
        "default": "./dist/hints.js"
      },
      "require": {
        "types": "./dist/cjs/hints.d.ts",
        "default": "./dist/hints.cjs"
      }
    },
    "./core.css": "./dist/gamepadify-core.css",
    "./navigation.css": "./dist/gamepadify-navigation.css"
  },
  "jsdelivr": "dist/gamepadify.min.js",
  "unpkg": "dist/gamepadify.min.js",
  "style": "dist/gamepadify.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "author": "gevmarlen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gevmarlen/gamepadify.git",
    "directory": "packages/core"
  },
  "homepage": "https://gevmarlen.github.io/gamepadify/",
  "bugs": "https://github.com/gevmarlen/gamepadify/issues",
  "keywords": [
    "gamepad",
    "gamepad-api",
    "controller",
    "spatial-navigation",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
